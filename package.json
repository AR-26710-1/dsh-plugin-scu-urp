{
  "name": "dsh-plugin-scu-urp",
  "version": "1.0.0",
  "type": "module",
  "description": "DeepSeek Harness 四川大学教务系统 (URP) 与微服务助手：免密自动登录、高颜值课表、手机日历同步、培养方案大纲与保研GPA测算、考试与空闲教室、一卡通流水与宿舍电费监控",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ai-crafted",
    "ai-generated",
    "scu-urp",
    "cordis",
    "education"
  ],
  "author": "AR-26710-1 (Created with Antigravity + Gemini 3.8 Flash)",
  "repository": {
    "type": "git",
    "url": "https://github.com/AR-26710-1/dsh-plugin-scu-urp.git"
  },
  "homepage": "https://github.com/AR-26710-1/dsh-plugin-scu-urp#readme",
  "bugs": {
    "url": "https://github.com/AR-26710-1/dsh-plugin-scu-urp/issues"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "marketplace.json",
    "server/*.py",
    "server/requirements.txt",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "start:server": "python server/app.py"
  },
  "license": "MIT"
}
