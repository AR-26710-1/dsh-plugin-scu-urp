{
  "name": "@local/scu-urp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 四川大学教务系统 (URP) 插件：左侧边栏自动登录与课表、成绩、考试安排快速可视化查询",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "server",
    "bin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "start:server": "python server/app.py"
  },
  "license": "MIT"
}
